<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_telemetry</name>
  <version>0.1.0</version>
  <description>ROS 2 telemetry simulator and freshness-tracking gateway.</description>

  <maintainer email="31817478+reinhard-z@users.noreply.github.com">Reinhard Zach</maintainer>
  <license>MIT</license>
  <url type="repository">https://github.com/reinhard-z/robot-telemetry-gateway</url>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
